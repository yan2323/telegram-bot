    writer.writerow(['\uc0\u26085 \u26399 \u26178 \u38291 ', '\u21830 \u21697 \u21517 ', '\u20729 \u26684 ', '\u26684 \u23376 \u34399 ', '\u27512 \u23660 '])\
    writer.writerows(rows)\
    output.write(text_output.getvalue().encode('utf-8'))\
    output.seek(0)\
    await update.message.reply_document(\
        document=output,\
        filename="\uc0\u26684 \u23376 \u33302 \u37559 \u21806 \u22577 \u34920 .csv",\
        caption="\uc0\u55357 \u56522  \u20840 \u37096 \u21407 \u22987 \u37559 \u21806 \u36039 \u26009 \u24050 \u21295 \u20986 \u65292 \u35531 \u26597 \u25910 \u65281 "\
